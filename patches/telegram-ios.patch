+        self.polusLoading = true
+        Task { @MainActor [weak self] in
+            guard let self else { return }
+            defer { self.polusLoading = false }
+            let account = String(self.context.account.peerId.id._internalGetInt64Value()), peer = String(self.peerId.id._internalGetInt64Value())
+            let profile = await PolusTelegramExchange.load(context: self.context, peer: self.peerId, onMetadata: { [weak self] profile in self?.applyPolusProfile(profile, account: account, peer: peer) })
+            self.applyPolusProfile(profile, account: account, peer: peer)
