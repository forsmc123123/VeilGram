+    private func addPolusGift(_ gift: StarGift.UniqueGift) {
+        let account = String(self.context.account.peerId.id._internalGetInt64Value())
+        let item = "nft:\(gift.slug)"
+        let current = PolusProfileService.showcase(account)
+        guard !current.contains(item) else {
+            self.showPolusMessage("Этот NFT уже в твоей витрине.")
+            return
+        }
+        guard current.count < 12, PolusProfileService.giftCost(item) != nil else {
+            self.showPolusMessage("В витрине помещается до 12 добавленных NFT.")
+            return
+        }
+        PolusProfileService.setShowcase([item] + current, account: account)
+        self.publishPolusProfile(account: account)
+        self.updatePolusGiftShelf()
+        self.requestLayout()
+        self.showPolusMessage("\(gift.title) #\(gift.number) добавлен в витрину VeilGram.")
+    }
+
+    private func openPolusGift(_ item: String) {
+        let account = String(self.context.account.peerId.id._internalGetInt64Value())
+        let saved = PolusProfileService.showcase(account)
+        let alert = UIAlertController(title: "Визуальный подарок VeilGram", message: "Копия для оформления профиля.", preferredStyle: .alert)
+        if item.hasPrefix("nft:"), PolusProfileService.giftCost(item) != nil,
+           let url = URL(string: "https://t.me/nft/" + String(item.dropFirst(4))) {
+            alert.addAction(UIAlertAction(title: "Открыть оригинал", style: .default) { _ in UIApplication.shared.open(url) })
+        }
+        if self.peerId == self.context.account.peerId, saved.contains(item) {
+            alert.addAction(UIAlertAction(title: "Убрать из витрины", style: .destructive) { [weak self] _ in
+                PolusProfileService.setShowcase(PolusProfileService.showcase(account).filter { $0 != item }, account: account)
+                self?.publishPolusProfile(account: account)
+                self?.updatePolusGiftShelf()
+                self?.requestLayout()
+            })
+        }
+        alert.addAction(UIAlertAction(title: "Закрыть", style: .cancel))
+        self.controller?.present(alert, animated: true, completion: nil)
+    }
+
+    private func updatePolusPanel() {
