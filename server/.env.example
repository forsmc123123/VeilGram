PROFILE_DOMAIN=profiles.example.com
# Issue invitations with node index.mjs invite TELEGRAM_ID. To enable the legacy bot, set
# TELEGRAM_BOT_ENABLED=1 and TELEGRAM_BOT_TOKEN.
# Standalone deployment can set HOST, PORT, TLS_CERT, and TLS_KEY.
# Server archives require TELEGRAM_API_ID, TELEGRAM_API_HASH, and ARCHIVE_KEY.
# Automatic profile registration uses the same API configuration and a separate Telegram
# account. Set VEILGRAM_REGISTRATION_PEER to its numeric user ID and give it a public username.
# VEILGRAM_REGISTRATION_PASSWORD is only needed during initial pairing if the account has 2FA.
